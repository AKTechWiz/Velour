# ==============================================================================
# VELOUR E-COMMERCE CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env.local and populate with your credentials.

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="VELOUR"

# InsForge Backend Configuration
NEXT_PUBLIC_INSFORGE_URL="https://your-project.insforge.app"
NEXT_PUBLIC_INSFORGE_ANON_KEY="your-anon-key"
INSFORGE_API_KEY="your-api-key"

# Currency & Payments
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_PAYPAL_ME_URL="https://paypal.me/YourPayPalUsername"
